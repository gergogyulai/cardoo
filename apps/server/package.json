{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@cardoo/env": "workspace:*",
    "dotenv": "catalog:",
    "hi-base32": "^0.5.1",
    "hono": "^4.8.2",
    "node-html-parser": "^7.1.0",
    "php-serialize": "^5.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cardoo/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.16.5",
    "typescript": "^5"
  }
}
